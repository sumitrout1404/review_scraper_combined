# Base URL of the FastAPI backend (no trailing slash).
# Prefer 127.0.0.1 over localhost locally: on Windows "localhost" tries IPv6 first and
# adds ~200ms per request. In production set this to the deployed API origin, and add the
# same origin to connect-src in vercel.json (the build fails if they disagree).
VITE_API_BASE_URL=http://127.0.0.1:8000
