# Copy to backend/.env for local development. All values are optional unless noted.
ENV=development                      # "production" disables API docs and enables HSTS

# --- Database (MongoDB) ---
MONGODB_URI=                         # REQUIRED. mongodb+srv://<user>:<password>@<cluster>/  (mongomock:// = in-memory, tests only)
MONGODB_URI_READONLY=                # optional read-only user for the public API (least privilege)
MONGODB_DB=scraper                   # database name
MONGODB_COLLECTION_PREFIX=scraper_   # every collection is prefixed, e.g. scraper_reviews

# --- API ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   # comma-separated allowlist of dashboard origins
CACHE_MAX_AGE=300                    # seconds of Cache-Control on public GETs
RATE_LIMIT_PER_MINUTE=120            # per-IP limit (0 disables)
CRON_SECRET=                         # REQUIRED for /api/cron/collect. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"

# --- Analysis ---
GROQ_API_KEY=                        # optional; without it the keyword-rules classifier is used
GROQ_MODEL=openai/gpt-oss-120b
ANALYSIS_LLM_WINDOW_DAYS=180         # only reviews this recent are sent to the LLM
ANALYSIS_LLM_MAX_REVIEWS_PER_RUN=400 # protects the Groq free-tier daily token limit

# --- Collector ---
COLLECTOR_STRATEGIES=http_graphql,browser_graphql,browser_dom   # on Vercel use: http_graphql
COLLECTOR_REQUEST_DELAY_S=1.5
COLLECTOR_REQUEST_JITTER_S=1.5
COLLECTOR_BACKFILL_MAX_PAGES=200
COLLECTOR_PROBE_HEADLINE_SCORE=true  # needs Playwright; set false on Vercel
